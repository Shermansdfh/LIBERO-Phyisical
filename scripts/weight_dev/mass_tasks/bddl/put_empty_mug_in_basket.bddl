(define (problem empty_mug_mass_sensing)
  (:domain robosuite)
  (:language identify the empty mug by mass and put the empty mug into the basket)

  (:regions
    (basket_init_region
      (:target main_table)
      (:ranges (
        (0.22 0.21 0.27 0.26)
      ))
      (:yaw_rotation (
        (0.0 0.0)
      ))
    )
    (plain_mug_left_init_region
      (:target main_table)
      (:ranges (
        (-0.30 -0.09 -0.26 -0.05)
      ))
      (:yaw_rotation (
        (0.0 0.0)
      ))
    )
    (plain_mug_right_init_region
      (:target main_table)
      (:ranges (
        (-0.18 -0.09 -0.14 -0.05)
      ))
      (:yaw_rotation (
        (0.0 0.0)
      ))
    )
    (yellow_mug_init_region
      (:target main_table)
      (:ranges (
        (-0.06 -0.09 -0.02 -0.05)
      ))
      (:yaw_rotation (
        (0.0 0.0)
      ))
    )
    (empty_mug_init_region
      (:target main_table)
      (:ranges (
        (0.06 -0.09 0.10 -0.05)
      ))
      (:yaw_rotation (
        (0.0 0.0)
      ))
    )
    (contain_region
      (:target basket_1)
    )
  )

  (:fixtures
    main_table - table
  )

  (:objects
    plain_mug_1 plain_mug_2 - libero_mug
    yellow_mug_1 - libero_mug_yellow
    empty_mug_1 - empty_libero_mug_yellow
    basket_1 - basket
  )

  (:obj_of_interest
    plain_mug_1
    plain_mug_2
    yellow_mug_1
    empty_mug_1
    basket_1
  )

  (:init
    (On plain_mug_1 main_table_plain_mug_left_init_region)
    (On plain_mug_2 main_table_plain_mug_right_init_region)
    (On yellow_mug_1 main_table_yellow_mug_init_region)
    (On empty_mug_1 main_table_empty_mug_init_region)
    (On basket_1 main_table_basket_init_region)
  )

  (:goal
    (And (In empty_mug_1 basket_1_contain_region))
  )
)
