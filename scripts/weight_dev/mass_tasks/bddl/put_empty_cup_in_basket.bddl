(define (problem empty_cup_mass_sensing)
  (:domain robosuite)
  (:language identify the light cup with straw by mass and put it into the basket)

  (:regions
    (clutter_init_region
      (:target main_table)
      (:ranges (
        (-0.18 -0.12 0.18 0.12)
      ))
      (:yaw_rotation (
        (-3.14 3.14)
      ))
    )

    (contain_region
      (:target basket_1)
    )
  )

  (:fixtures
    main_table - table
  )

  (:objects
    unopened_cup_1 unopened_cup_2 - 50_cup_no_straw
    straw_light_cup_1 - 50_cup_with_straw_light
    straw_heavy_cup_1 - 50_cup_with_straw_heavy
    basket_1 - basket
  )

  (:obj_of_interest
    unopened_cup_1
    unopened_cup_2
    straw_light_cup_1
    straw_heavy_cup_1
    basket_1
  )

  (:init
    (On unopened_cup_1 main_table_clutter_init_region)
    (On unopened_cup_2 main_table_clutter_init_region)
    (On straw_light_cup_1 main_table_clutter_init_region)
    (On straw_heavy_cup_1 main_table_clutter_init_region)
    (On basket_1 main_table_clutter_init_region)
  )

  (:goal
    (And (In straw_light_cup_1 basket_1_contain_region))
  )
)