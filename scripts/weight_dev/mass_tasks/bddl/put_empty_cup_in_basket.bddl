(define (problem empty_cup_mass_sensing)
  (:domain robosuite)
  (:language identify the light cup with straw by mass and put it into the basket)

  (:regions
    (basket_init_region
      (:target main_table)
      (:ranges (
        (0.22 0.21 0.27 0.26)
      ))
      (:yaw_rotation (
        (0.0 0.0)
      ))
    )
    (unopened_cup_left_init_region
      (:target main_table)
      (:ranges (
        (-0.30 -0.09 -0.26 -0.05)
      ))
      (:yaw_rotation (
        (0.0 0.0)
      ))
    )
    (unopened_cup_right_init_region
      (:target main_table)
      (:ranges (
        (-0.18 0.05 -0.14 0.09)
      ))
      (:yaw_rotation (
        (0.0 0.0)
      ))
    )
    (straw_light_cup_init_region
      (:target main_table)
      (:ranges (
        (-0.06 -0.09 -0.02 -0.05)
      ))
      (:yaw_rotation (
        (0.0 0.0)
      ))
    )
    (straw_heavy_cup_init_region
      (:target main_table)
      (:ranges (
        (0.06 0.05 0.10 0.09)
      ))
      (:yaw_rotation (
        (0.0 0.0)
      ))
    )
    (contain_region
      (:target basket_1)
    )
  )

  (:fixtures
    main_table - table
  )

  (:objects
    unopened_cup_1 unopened_cup_2 - 50_cup_no_straw
    straw_light_cup_1 - 50_cup_with_straw_light
    straw_heavy_cup_1 - 50_cup_with_straw_heavy
    basket_1 - basket
  )

  (:obj_of_interest
    unopened_cup_1
    unopened_cup_2
    straw_light_cup_1
    straw_heavy_cup_1
    basket_1
  )

  (:init
    (On unopened_cup_1 main_table_unopened_cup_left_init_region)
    (On unopened_cup_2 main_table_unopened_cup_right_init_region)
    (On straw_light_cup_1 main_table_straw_light_cup_init_region)
    (On straw_heavy_cup_1 main_table_straw_heavy_cup_init_region)
    (On basket_1 main_table_basket_init_region)
  )

  (:goal
    (And (In straw_light_cup_1 basket_1_contain_region))
  )
)
